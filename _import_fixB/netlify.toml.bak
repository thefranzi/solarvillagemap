# This is the ONLY netlify.toml file in your project.
# It should be in the root directory.

[build]
  # This tells Netlify what command to run to build your site. 
  # If you don't have a build step (just HTML/CSS/JS), this is fine.
  command = "echo 'No build step'"
  
  # This is the directory that contains your deployed site files (e.g., index.html).
  # If your index.html is in the root, this should be "."
  publish = "."

# This section is the most important part.
[functions]
  # This tells Netlify to look for all your function source code
  # inside the 'netlify/functions' directory.
  directory = "netlify/functions"

# --- Security headers ---
[[headers]]
  for = "/*"
  [headers.values]
    Referrer-Policy = "strict-origin-when-cross-origin"
    X-Content-Type-Options = "nosniff"
// REMOVED_BY_MOBILE_FIX:     Permissions-Policy = "geolocation=(self), camera=(self), microphone=()"
    Content-Security-Policy = "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' /.netlify/functions/* https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
